# dns-edge 本机联调配置
# edgeapi 作为 DNS Provider caller，通过 edgeDNSAPI 接口管理记录

dns-edge {
    listen  :5300
    workers 0
    tcp     true

    api {
        listen :8080

        # edgeDNSAPI credentials — edgeapi 用这组 key 来认证
        edgedns_access_key_id     local-dns-edge-01
        edgedns_access_key_secret localSecret123456
    }

    sync {
        interval  30s
        prob      0.01
        ratelimit 100
    }

    geo {
        auto_update     true
        update_interval 24h
    }

    edgeagent {
        endpoint  127.0.0.1:8031
        unique_id a1b2c3d4e5f64a7b8c9d0e1f2a3b4c5d
        secret    d5c4b3a2f1e04d3c2b1a0f9e8d7c6b5a
    }

    # DoT/DoH 本机验证用（非特权端口，本机用户跑不需要 setcap/sudo）
    tls {
        listen :8853
    }

    doh {
        listen :8443
    }
}
